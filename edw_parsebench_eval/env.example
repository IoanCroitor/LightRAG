# ParseBench RAG Evaluation Configuration
# Copy to edw_parsebench_eval/.env and configure your key:

# LightRAG server under test
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=

# LLM Ground-Truth & Judge configuration (OpenRouter or any OpenAI-compatible API)
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
LLM_API_KEY=
LLM_MODEL=
JUDGE_MODEL=

# Query settings
LIGHTRAG_QUERY_MODE=mix

# Parallel concurrency
PARSEBENCH_WORKERS=4
